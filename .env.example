# Copy to .env and fill in. Never commit .env or the service-account key.
# Which LLM backend: ollama (local, default, free) | claude (Vertex AI) | fake (offline tests)
CUEMIND_LLM=ollama
CUEMIND_OLLAMA_MODEL=qwen2.5:7b-instruct
# --- Claude on Vertex AI (only needed when CUEMIND_LLM=claude) ---
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=global
CUEMIND_MODEL=claude-haiku-5-5
CUEMIND_EFFORT=medium
CUEMIND_MAX_USD=5
CUEMIND_LLM_CACHE=results/cache/llm_cache.sqlite
PYTHONIOENCODING=utf-8
